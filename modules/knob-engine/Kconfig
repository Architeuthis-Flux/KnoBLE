config KNOB_ENGINE
    bool "KnoBLE knob engine (AS5600 detents + haptics + sliders)"
    default y
    depends on DT_HAS_BASELINE_KNOB_ENGINE_ENABLED
    select SENSOR
    select INPUT

if KNOB_ENGINE

config KNOB_ENGINE_INIT_PRIORITY
    int "Init priority"
    default 91

config KNOB_SETTINGS
    bool "Runtime settings over vendor raw HID (USB): key remap, persistence"
    default y
    depends on ZMK_USB
    select SETTINGS
    help
      QMK-raw-HID-shaped channel (usage page 0xFF60) on a second USB HID
      instance; requires CONFIG_USB_HID_DEVICE_COUNT=2. The companion app
      remaps the key slots at runtime; values persist in NVS. The keymap
      must bind &kslot for slots to take effect. BLE transport is a
      follow-up — configuration happens over the cable, like VIA.

config KNOB_WHEEL_RES_MULTIPLIER
    int
    default 16 if ZMK_POINTING_SMOOTH_SCROLLING
    default 1
    help
      Wheel sub-units emitted per count. Tracks ZMK's smooth scrolling
      (HID Resolution Multiplier, x16 descriptor): hosts that honor the
      multiplier (Windows, Linux) divide our values by 16, so pacing is
      unchanged but 16x finer-grained. Hosts that ignore it (macOS) see
      raw sub-units as whole notches — 16x too fast — so only enable
      ZMK_POINTING_SMOOTH_SCROLLING in builds aimed at hosts that honor
      the multiplier.

module = KNOB_ENGINE
module-str = knob_engine
source "subsys/logging/Kconfig.template.log_config"

endif
