if SHIELD_KNOBLE

config ZMK_KEYBOARD_NAME
    default "KnoBLE"

# The knob engine needs the AS5600 angle sensor and I2C.
config I2C
    default y

config SENSOR
    default y

# The knob emits pointer (wheel) events through ZMK's input pipeline.
config ZMK_POINTING
    default y

config INPUT
    default y

# 3x WS2812 over SPI, driven directly by knob-engine as a speed gauge
# (ZMK RGB underglow stays off — two writers would fight over the strip).
config WS2812_STRIP
    default y

config LED_STRIP
    default y

config SPI
    default y

endif
