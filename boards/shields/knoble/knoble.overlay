/*
 * KnoBLE — wireless Knob v2.1 (nRF52840 SuperMini / nice!nano v2 compatible)
 *
 * Pin map — matches the Knob v2.1 PCB with a SuperMini dropped into the
 * Pro Micro footprint (AVR pin -> pro micro position -> nRF52840):
 *   I2C SDA/SCL (AS5600)   PD1/PD0  D2 / D3     P0.17 / P0.20
 *   Key prev (was B5)               D9          P1.06
 *   Key play/pause (was B4)         D8          P1.04
 *   Key next (was E6)               D7          P0.11
 *   WS2812 data (was B6)            D10         P0.09  (NFC pin — needs
 *                                   CONFIG_NFCT_PINS_AS_GPIOS=y, set in conf)
 *   DRV2605L                        same I2C bus, wire to D2/D3 + 3V3/GND
 *   Sliders (future PCB)            A1 A2 A3    P0.02=AIN0, P0.29=AIN5, P0.31=AIN7
 *                                   !! A0 (P1.15) is NOT ADC-capable.
 */

/* keys.h first: it also defines an RC() macro (right-ctrl modifier) that
 * would otherwise clobber matrix_transform.h's RC(row,col). */
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/led/led.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,physical-layout = &knoble_layout;
        zmk,underglow = &led_strip;
    };

    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios
            = <&pro_micro 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            ;
    };

    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        rows = <1>;
        columns = <3>;
        map = <RC(0,0) RC(0,1) RC(0,2)>;
    };

    knoble_layout: knoble_layout {
        compatible = "zmk,physical-layout";
        display-name = "KnoBLE";
        kscan = <&kscan0>;
        transform = <&default_transform>;
        keys /* w h x y rot rx ry */
            = <&key_physical_attrs 100 100   0 0 0 0 0>
            , <&key_physical_attrs 100 100 100 0 0 0 0>
            , <&key_physical_attrs 100 100 200 0 0 0 0>
            ;
    };

    /*
     * The knob engine: AS5600 angle -> virtual detents -> scroll/keycodes,
     * with a DRV2605 haptic pulse per detent. Profiles are selected by the
     * highest active layer; layers with no profile fall back to profile 0.
     */
    knob0: knob_engine {
        compatible = "baseline,knob-engine";
        sensor = <&as5600>;
        haptics = <&drv2605>;
        led-strip = <&led_strip>;   /* speed gauge; underglow is disabled */
        poll-hz = <250>;
        idle-poll-hz = <25>;
        /* Scroll goes out as +/-1 unit events, one per interval — hosts in
         * fixed-pixel mode (LinearMouse) only honor event sign, so rate IS
         * the speed. 5ms = up to 200 units/s; pair with LinearMouse "6px"
         * => ~1200px/s ceiling. */
        wheel-report-interval-ms = <5>;

        /* Slider 0: pot wiper on P0.31 (silkscreen 031) = AIN7.
         * !! Power the pot from the 3.3V VCC pin, NOT RAW — the nRF's analog
         * !! input absolute max is VDD+0.3V; a 5V wiper would damage it. */
        slider-channels = <7>;

        profile_scroll {
            layer = <0>;
            mode = "scroll";
            detents-per-rev = <16>;   /* haptic/texture grid */
            lines-per-rev = <96>;     /* output units per rev; with the 5ms
                                       * unit-event drip and LinearMouse 8px:
                                       * 1 rev = ~770px at x1, ceiling at
                                       * ~2 rps worth of events */
            haptic-effect = <1>;              /* TI lib 6: strong click 100% */
            input-code = <INPUT_REL_WHEEL>;
            /* slider sets scroll speed, bottom to top:
             * /5 /4 /3 /2, x1, x2 x3 x4 — linear travel. Output is strictly
             * proportional to rotation; disable macOS's per-device scroll
             * acceleration (LinearMouse) instead of masking it here. */
            slider-role = "wheel-scale";
            slider-index = <0>;
            wheel-scale-max = <4>;
            wheel-scale-min-div = <5>;
            slider-curve-power = <1>;
        };

        profile_volume {
            layer = <1>;
            mode = "keycode";
            detents-per-rev = <48>;
            haptic-effect = <26>;             /* TI lib 6: sharp tick */
            cw-code = <C_VOL_UP>;
            ccw-code = <C_VOL_DN>;
            /* Slider 1 as its own control (e.g. timeline zoom -> horizontal wheel):
            slider-role = "own-control";
            slider-index = <1>;
            slider-input-code = <INPUT_REL_HWHEEL>;
            slider-steps = <32>;
            slider-effect = <21>;
            */
        };

        /* Example bounded profile — knob sweeps a 0..100 value with a hard
         * end-stop buzz at the limits (add a layer 2 to use it):
        profile_zoom {
            layer = <2>;
            mode = "bounded";
            detents-per-rev = <36>;
            haptic-effect = <7>;
            input-code = <INPUT_REL_HWHEEL>;
            range-min = <0>;
            range-max = <100>;
            endstop-effect = <14>;
        };
        */
    };

    /* Routes the knob engine's input events into ZMK's HID pipeline.
     * Without this listener the events go nowhere. */
    knob0_listener {
        compatible = "zmk,input-listener";
        device = <&knob0>;
    };

    /* Haptic feedback on key presses (zmk-output-behavior-listener). */
    lra0: output_haptic_fb_0 {
        compatible = "zmk,output-haptic-feedback";
        #binding-cells = <0>;
        driver = "drv2605";
        device = <&drv2605>;
    };

    obl_keys {
        compatible = "zmk,output-behavior-listener";
        layers = <0 1>;
        sources = <2>;  /* OUTPUT_SOURCE_POSITION_STATE_CHANGE */
        bindings = <&ob_key_click>;
    };

    ob_key_click: ob_key_click {
        compatible = "zmk,output-behavior-generic";
        #binding-cells = <0>;
        device = <&lra0>;
        force = <7>;                          /* TI lib 6: soft bump 100% */
    };
};

/* The nRF needs I2C pull-ups it can't inherit from the board def; the AVR
 * used its internal pull-ups, and the v2.1 PCB has no discrete ones. The
 * nRF52840's internal ~13k pulls are fine at 100 kHz. */
&i2c0_default {
    group1 {
        bias-pull-up;
    };
};

&pro_micro_i2c {
    status = "okay";

    as5600: as5600@36 {
        compatible = "ams,as5600";
        reg = <0x36>;
    };

    drv2605: drv2605@5a {
        compatible = "ti,drv2605";
        reg = <0x5a>;
        library = <6>;                        /* LRA waveform library */
        standby-ms = <1000>;
    };
};

&adc {
    status = "okay";
};

/* 3x WS2812 on D10 (P0.09, the v2.1's B6 position) via SPI3 MOSI.
 * P0.09 is an NFC pin: CONFIG_NFCT_PINS_AS_GPIOS=y (in knoble.conf)
 * reconfigures it as a regular GPIO. */
&pinctrl {
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 9)>;
        };
    };

    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 9)>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        reg = <0>;
        spi-max-frequency = <4000000>;
        chain-length = <3>;
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
        color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
    };
};
